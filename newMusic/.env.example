# FastAPI
APP_NAME=myMusic
DEBUG=false

# MySQL 数据库连接（根据服务器实际情况修改）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请修改为你的数据库密码
DB_NAME=myMusic
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT（务必修改为随机字符串）
JWT_SECRET_KEY=请修改为随机字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 服务端口
SERVER_PORT=8000

# 网易云 Cookie（从浏览器 F12 复制，过期后需要更新）
NETEASE_COOKIE="请修改为你的网易云Cookie"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
